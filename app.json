{
  "expo": {
    "name": "ARchSpace",
    "slug": "ARchSpace",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "archspace",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.archspace.app",
      "buildNumber": "1",
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "ARchSpace uses your camera for AR furniture placement and profile photos.",
        "NSPhotoLibraryUsageDescription": "ARchSpace accesses your photo library to set your profile picture and import design assets.",
        "NSPhotoLibraryAddUsageDescription": "ARchSpace saves rendered designs to your photo library.",
        "NSMicrophoneUsageDescription": "ARchSpace may access the microphone for AR session features.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.anonymous.ARchSpace"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "afbec39c-53c4-47fb-ba21-de2d957ee508"
      }
    }
  }
}
